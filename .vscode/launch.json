{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "name": "Run Script: run (backend)",
      "request": "launch",
      "command": "node --watch server.js",
      "cwd": "${workspaceFolder}\\backend/src"
    }
  ]
}
